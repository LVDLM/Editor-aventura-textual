+          {ENVELOPE_SHAPES.map((s) => (
+            <Chip key={s.id} isClean={isClean} active={activeEnv?.id === s.id} onClick={() => setVoicePlay({ envelope: s.pts })}>
+              {s.label}
+            </Chip>
+          ))}
+        </div>
+      </div>
+    </div>
+  );
+};
