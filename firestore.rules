rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function: check if user is admin
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'lavozdelosmuertos@gmail.com' ||
        request.auth.uid == 'ANwT8oJ21QdyQ54Oj5iodAA7B0J2' ||
        request.auth.uid == 'DhxW6Oy0QtQK3ghH5XYi3l6cWxJ2' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // Helper function: check if user is owner of document (by UID or Email)
    function isOwner(data) {
      return request.auth != null && (
        request.auth.uid == data.authorId ||
        (request.auth.token.email != null && data.authorEmail != null && request.auth.token.email == data.authorEmail) ||
        (request.auth.uid in ['ANwT8oJ21QdyQ54Oj5iodAA7B0J2', 'DhxW6Oy0QtQK3ghH5XYi3l6cWxJ2'] && data.authorEmail == 'lavozdelosmuertos@gmail.com')
      );
    }

    // Users collection
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow delete: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    // Projects collection
    match /projects/{projectId} {
      // Anyone (even unauthenticated visitors) can read published games
      // Allow read when resource is null (when checking non-existent document with getDoc before creation)
      // Authors can read their own games (by UID or Email)
      // Admins can read all games
      allow read: if resource == null || 
                     resource.data.status == 'published' || 
                     (request.auth != null && (isOwner(resource.data) || isAdmin()));

      // Authenticated users can create projects owned by themselves
      allow create: if request.auth != null && (
        request.resource.data.authorId == request.auth.uid || isAdmin()
      );

      // Authors can update their own projects (as long as they don't self-publish unless they are admin)
      // Admins can update any project (including publishing and reviewing)
      // Readers can update the aggregated rating fields
      allow update: if (
        (request.auth != null && (
          isAdmin() || 
          (isOwner(resource.data) && (request.resource.data.status != 'published' || resource.data.status == 'published'))
        )) ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ratingCount', 'ratingTotal', 'ratingAverage']) &&
          request.resource.data.ratingCount is number &&
          request.resource.data.ratingTotal is number &&
          request.resource.data.ratingAverage is number
        )
      );

      // Authors can delete their own drafts/projects, Admins can delete any
      allow delete: if (resource != null && isOwner(resource.data)) || isAdmin();
    }

    // Story ratings collection (1-5 stars submitted upon completing a story)
    match /story_ratings/{ratingId} {
      allow read: if true;
      allow create, update: if request.resource.data.rating is number &&
                               request.resource.data.rating >= 1 &&
                               request.resource.data.rating <= 5 &&
                               request.resource.data.storyId is string;
      allow delete: if isAdmin();
    }

    // Global settings & shared sound library collection
    match /global_settings/{settingId} {
      // Anyone can read official platform sound presets
      allow read: if true;
      // Only Administrators can update or expand the official sound library
      allow write: if isAdmin();
    }
  }
}
