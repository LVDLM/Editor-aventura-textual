{
  "entities": {
    "users": {
      "title": "User Profile",
      "description": "User accounts, profiles and role management",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "author"] },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "email", "role"]
    },
    "projects": {
      "title": "Game Project",
      "description": "Interactive text adventure game projects, drafts and published stories",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "authorEmail": { "type": "string" },
        "status": { "type": "string", "enum": ["draft", "pending_review", "published", "rejected"] },
        "projectData": { "type": "object" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "publishedAt": { "type": "string" },
        "reviewFeedback": { "type": "string" }
      },
      "required": ["title", "authorId", "status", "projectData"]
    },
    "global_settings": {
      "title": "Global System Settings & Sound Library",
      "description": "Global application configuration and shared official sound presets",
      "type": "object",
      "properties": {
        "sounds": { "type": "array" },
        "updatedAt": { "type": "string" },
        "updatedBy": { "type": "string" }
      }
    }
  }
}
